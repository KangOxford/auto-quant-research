          {
            "type": "command",
            "command": "bash ${HOME}/.claude/hooks/translate-prompt-stop.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ${HOME}/.claude/hooks/extract-insights.sh",
            "timeout": 15,
            "async": true
          },
          {
            "type": "command",
            "command": "bash ${HOME}/.claude/hooks/btw-main-stop.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
