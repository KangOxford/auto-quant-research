            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${HOME}/.claude/hooks/auto-approve-skills-edits.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
